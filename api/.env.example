# Server
NODE_ENV="development"
PORT=8430

# Origins allowed list. Ex: "http://...,https://..." or "*" for all
CORS_ORIGINS="*"

# Database
DATABASE_URL="postgresql://docker:docker@localhost:5432/teamdrop?schema=public"

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=""

# Google Oauth
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_REDIRECT_URI=""