# Server
NODE_ENV="development"
PORT=8430

# Origins allowed list. Ex: "http://...,https://..." or "*" for all
CORS_ORIGINS="*"

# Database
DATABASE_URL="postgresql://docker:docker@localhost:5432/teamdrop?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=""

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=""

# Google Oauth
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_REDIRECT_URI="http://localhost:8430/api/auth/google/callback"
