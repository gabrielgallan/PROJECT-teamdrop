{
	"$schema": "https://www.schemastore.org/tsconfig",
	"display": "Node 24",
	"_version": "24.0.0",

	"compilerOptions": {
		"lib": ["es2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"target": "es2024",
		"types": ["node"],

		"rootDir": "./",
		"outDir": "./dist",

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,

		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},

	"exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
