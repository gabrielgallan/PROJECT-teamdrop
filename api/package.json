{
	"engines": {
		"node": "24.x"
	},
	"name": "@teamdrop/api",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:prod": "node dist/main",
		"db:dev": "prisma migrate dev",
		"db:prod": "prisma migrate deploy",
		"db:generate": "prisma generate",
		"docker:up": "docker compose -f docker/compose.yml up -d",
		"docker-test:up": "docker compose -f docker/compose.test.yml up -d --wait",
		"docker-test:down": "docker compose -f docker/compose.test.yml down",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@azure/storage-blob": "12.34.0",
		"@nestjs/common": "11.0.1",
		"@nestjs/config": "12.0.1",
		"@nestjs/core": "11.0.1",
		"@nestjs/jwt": "12.0.5",
		"@nestjs/mapped-types": "12.0.1",
		"@nestjs/platform-express": "11.0.1",
		"@nestjs/platform-socket.io": "11.0.1",
		"@nestjs/schedule": "12.0.4",
		"@nestjs/swagger": "11.2.0",
		"@nestjs/throttler": "6.8.0",
		"@nestjs/websockets": "11.0.1",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"@scalar/nestjs-api-reference": "1.2.30",
		"dotenv": "18.0.10",
		"ioredis": "6.0.0",
		"multer": "2.5.0",
		"nestjs-zod": "5.5.0",
		"pg": "8.23.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.1",
		"socket.io": "4.8.4",
		"uuid": "14.0.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.0",
		"@nestjs/schematics": "11.0.0",
		"@nestjs/testing": "11.0.1",
		"@swc/core": "1.16.22",
		"@types/express": "5.0.0",
		"@types/multer": "2.3.0",
		"@types/node": "24.0.0",
		"@types/supertest": "7.2.1",
		"prisma": "7.10.1",
		"source-map-support": "0.5.21",
		"supertest": "7.3.2",
		"ts-loader": "9.5.2",
		"ts-node": "10.9.2",
		"tsconfig-paths": "4.2.0",
		"typescript": "5.7.3",
		"unplugin-swc": "2.0.0",
		"vitest": "5.1.2"
	}
}
