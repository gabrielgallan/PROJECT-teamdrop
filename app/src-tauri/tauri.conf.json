{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TeamDrop",
	"identifier": "com.gabri.tauri-app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"plugins": {
		"deep-link": { "desktop": { "schemes": ["teamdrop"] } }
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "TeamDrop",
				"width": 340,
				"height": 520,
				"dragDropEnabled": false,
				"decorations": false,
				"minimizable": false,
				"maximizable": false,
				"transparent": true,
				"windowEffects": {
					"effects": ["acrylic"]
				},
				"resizable": true,
				"alwaysOnTop": true,
				"visible": false,
				"skipTaskbar": true,
				"focus": true
			}
		]
	}
}
