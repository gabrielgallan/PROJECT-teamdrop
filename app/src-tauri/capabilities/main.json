{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "Allows the widget to open the native file picker.",
	"windows": ["main"],
	"permissions": [
		"dialog:allow-open",
		"fs:allow-read-file",
		"store:allow-load",
		"store:allow-get",
		"store:allow-set",
		"store:allow-save",
		"clipboard-manager:allow-write-text",
		"deep-link:allow-get-current",
		"core:event:allow-listen",
		"core:event:allow-unlisten"
	]
}
